{
  "_": "美术风格的【唯一真源】。gen.mjs 读它，ui-spec 的色板也该跟它对齐。改这里 = 改全局画风。",

  "grid": 32,
  "_grid": "逻辑网格（px）。1 格 = 32px。所有贴图、建筑、人物都对齐它。",

  "authorScale": 2,
  "_authorScale": "SVG 用 2× 坐标绘制、按 2× 声明尺寸（Pixi 拿到 2× 纹理，sprite.scale=0.5）。清单里给的是【逻辑尺寸】。",

  "rules": [
    "平涂 + 1px 深色描边。不用渐变做体积（渐变只用在「高光偏一点」和「水」）。",
    "俯视，但底部留 4~5px 的【立面揭示】= 假的厚度。这是「看着立体」的全部秘密。",
    "落影单独一层（偏移 2,3 · 黑 12%），方便夜/雨复用、也方便关掉。",
    "一切对齐 32 网格。不许有半格的东西。",
    "单个资产最多 5 个颜色。多了就说明该拆图层。",
    "纹理 = 1px 重复图案，透明度 ≤22%。不用噪点、不用颗粒（缩小会糊成脏块）。"
  ],

  "palette": {
    "grass":     { "base": "#6d8a52", "dark": "#5f7a47", "light": "#7b9660" },
    "dirt":      { "base": "#a89476", "dark": "#96835f", "light": "#b8a486" },
    "plaza":     { "base": "#c9c2b1", "dark": "#b5ad9a", "light": "#d7d1c2" },
    "water":     { "base": "#5a7f96", "dark": "#4d6f85", "light": "#6d92a8" },

    "asphalt":   { "base": "#4c4a4a", "light": "#565454" },
    "sidewalk":  { "base": "#b8b3a6", "line": "#a49e8f" },
    "marking":   "#e9e5da",

    "roof": {
      "shop":    { "base": "#8c5b48", "dark": "#7a4c3c", "light": "#9e6b56" },
      "home":    { "base": "#7a6a5a", "dark": "#6a5b4c", "light": "#8b7a68" },
      "factory": { "base": "#6b7176", "dark": "#5c6166", "light": "#7b8186" },
      "mine":    { "base": "#8a6a4e", "dark": "#785b42", "light": "#9b7a5c" }
    },
    "wall":      { "base": "#d6c6a5", "dark": "#c2b192" },
    "door":      { "base": "#5a4a3c", "dark": "#463a2f" },
    "window":    { "day": "#8fa3ad", "night": "#ecc579" },

    "tree":      { "base": "#4f7a45", "dark": "#3d6236", "light": "#5f8f52", "trunk": "#6b5138" },
    "car":       ["#8d5a4e", "#5c6b78", "#7d7a6a", "#4f6b58"],
    "metal":     { "base": "#8a8779", "dark": "#6f6c60" },

    "skin":      ["#e6c9a8", "#d9b48f", "#c9a07a"],
    "outline":   "#000000",

    "shadow":    "rgba(0,0,0,0.12)",
    "accent":    "#b4552d",
    "ok":        "#4a7358"
  },

  "building": {
    "facadeReveal": 5,
    "_facadeReveal": "底部立面揭示高度（逻辑 px）= 假厚度",
    "wallThickness": 1,
    "signInset": { "x": 7, "y": 6, "h": 13 },
    "_signInset": "招牌底的位置；字由代码画（编辑器能改名，不能写进贴图）",
    "shadow": { "dx": 4, "dy": 5, "alpha": 0.1 }
  },

  "person": {
    "canvas": { "w": 18, "h": 24 },
    "_canvas": "逻辑画布；锚点在【脚底中心】",
    "bodies": {
      "slim":    { "shoulderRx": 4.6, "shoulderRy": 5.4, "headR": 3.7, "legW": 2.4 },
      "medium":  { "shoulderRx": 5.4, "shoulderRy": 5.9, "headR": 3.9, "legW": 2.8 },
      "stocky":  { "shoulderRx": 6.2, "shoulderRy": 6.0, "headR": 4.1, "legW": 3.2 }
    },
    "walkFrames": 4,
    "_walkFrames": "走 4 帧 + 站 1 帧；腿摆幅 ±1.6px，身体上下浮动 0.8px（2 帧一循环）",
    "directions": ["down", "up", "side"],
    "_directions": "side 靠水平镜像出左右 —— 省一半文件",
